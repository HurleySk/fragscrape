# Proxy Configuration (optional — omit or leave empty to use direct connections)
# Full proxy URL including credentials (from Decodo dashboard)
# Format: http://user-USERNAME-country-COUNTRY:PASSWORD@gate.decodo.com:7000
# DECODO_PROXY_URL=http://user-USERNAME-country-us:PASSWORD@gate.decodo.com:7000

# API Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/fragscrape.db

# Logging (use 'info' for production, 'debug' for development)
LOG_LEVEL=info

# Log File Rotation
LOG_FILE_MAX_SIZE_MB=5         # Max size per log file (default: 5MB)
LOG_FILE_MAX_FILES=5           # Number of rotated files to keep (default: 5)

# Cleanup Configuration
LOG_RETENTION_DAYS=30          # Keep database request logs for 30 days (default: 30)
CLEANUP_INTERVAL_HOURS=24      # Run cleanup every 24 hours (default: 24)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Browser Configuration
# Optional: Path to Chrome/Chromium executable
# Leave empty to use Puppeteer's bundled Chrome
# On ARM64 (Raspberry Pi): /usr/bin/chromium-browser
# On macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Scraper Configuration
SCRAPER_BASE_URL=https://www.parfumo.com

# Cache Configuration
CACHE_PERFUME_DURATION_SECONDS=21600   # 6 hours (default: 21600)
CACHE_SEARCH_DURATION_SECONDS=3600     # 1 hour (default: 3600)

# Parfumo Browser Timeouts
PARFUMO_LOGIN_TIMEOUT_MS=300000        # Login flow timeout (default: 5 min)
PARFUMO_ACTION_TIMEOUT_MS=30000        # Per-action timeout (default: 30s)
PARFUMO_SESSION_VERIFY_INTERVAL_MS=1800000  # Session revalidation (default: 30 min)
